# Environment Variables Template for Legal Aid Chatbot
# Copy this to .env and fill in your actual API keys

# ==================== PINECONE CONFIGURATION ====================
# Get your keys from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=gcp-starter

# ==================== GROQ API CONFIGURATION ====================
# Get your key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# ==================== OPTIONAL: HUGGINGFACE TOKEN ====================
# Required if using private HuggingFace models (not needed for public models)
# HUGGINGFACE_TOKEN=your_hf_token_here
